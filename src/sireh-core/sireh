#!/usr/bin/env python3
"""Sireh Core - read-only infrastructure diagnostics."""

import argparse
import os
import platform
import shutil
import socket
import sys

VERSION = "0.1.0"


def read_meminfo():
    values = {}
    try:
        with open("/proc/meminfo", encoding="utf-8") as stream:
            for line in stream:
                key, _, value = line.partition(":")
                values[key] = int(value.strip().split()[0]) * 1024
    except (OSError, ValueError, IndexError):
        pass
    return values


def gib(value):
    return f"{value / (1024 ** 3):.2f} GiB"


def show_info():
    print("Sireh OS Lite - System Information")
    print("----------------------------------")
    print(f"Hostname : {socket.gethostname()}")
    print(f"Kernel   : {platform.release()}")
    print(f"Arch     : {platform.machine()}")
    print(f"CPU cores: {os.cpu_count() or 'Unknown'}")

    memory = read_meminfo()
    if "MemTotal" in memory:
        print(f"Memory   : {gib(memory['MemTotal'])}")

    try:
        with open("/proc/uptime", encoding="utf-8") as stream:
            seconds = int(float(stream.read().split()[0]))
        print(f"Uptime   : {seconds // 3600}h {(seconds % 3600) // 60}m")
    except (OSError, ValueError, IndexError):
        print("Uptime   : Unavailable")


def show_doctor():
    print("Sireh Core - Read-only System Doctor")
    print("------------------------------------")

    warnings = 0

    try:
        disk = shutil.disk_usage("/")
        free_percent = disk.free / disk.total * 100
        disk_ok = free_percent >= 15
        print(f"[{'PASS' if disk_ok else 'WARN'}] Root disk free: {free_percent:.1f}%")
        warnings += not disk_ok
    except OSError as error:
        print(f"[WARN] Disk check unavailable: {error}")
        warnings += 1

    memory = read_meminfo()
    if "MemTotal" in memory and "MemAvailable" in memory:
        available = memory["MemAvailable"] / memory["MemTotal"] * 100
        memory_ok = available >= 15
        print(f"[{'PASS' if memory_ok else 'WARN'}] Memory available: {available:.1f}%")
        warnings += not memory_ok
    else:
        print("[WARN] Memory information unavailable")
        warnings += 1

    print(f"\nResult: {'PASS' if warnings == 0 else 'WARN'}")
    return 0 if warnings == 0 else 1


def main():
    parser = argparse.ArgumentParser(
        prog="sireh",
        description="Sireh Core - Infrastructure Swiss Army Knife",
    )
    parser.add_argument("--version", action="version", version=f"Sireh Core {VERSION}")
    parser.add_argument("command", nargs="?", choices=["help", "info", "doctor"])
    args = parser.parse_args()

    if args.command in (None, "help"):
        parser.print_help()
        return 0
    if args.command == "info":
        show_info()
        return 0
    return show_doctor()


if __name__ == "__main__":
    sys.exit(main())
